# ==============================================================================
# Reliable Job Engine - Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_DEBUG=true

# Server / API Configuration (cmd/server)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_password_placeholder
DB_NAME=reliable_job_engine
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Worker Fleet Configuration (cmd/worker)
WORKER_CONCURRENCY=10
WORKER_POLL_INTERVAL=500ms
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_SHUTDOWN_TIMEOUT=20s
WORKER_QUEUES=critical,high,default,low

# Retry and Backoff Policies
RETRY_BASE_BACKOFF=1s
RETRY_MAX_BACKOFF=300s
RETRY_MAX_ATTEMPTS=5
RETRY_JITTER_MODE=full

# Dead-Letter Queue (DLQ) Policies
DLQ_ENABLED=true
DLQ_MAX_REPLAY_LIMIT=3

# Observability and Telemetry
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_PORT=9090
